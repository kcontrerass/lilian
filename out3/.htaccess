# Next.js static export — cPanel (raíz public_html)
# Sube TODO el contenido de /out aquí: index.html, .htaccess, _next/, carpetas por ruta, etc.
# En el administrador: "Mostrar archivos ocultos" y verifica que .htaccess exista.

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# /pagina.html → /pagina/
RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)\.html[\s?] [NC]
RewriteRule ^ /%1/ [R=301,L]

# /pagina → /pagina/ (carpeta con index.html del export)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/ [R=301,L]
</IfModule>

ErrorDocument 404 /404.html
